__pycache__/
*.py[cod]
.venv/
.env
.env.*
.pytest_cache/
.ipynb_checkpoints/
*.tmp

# Upstream SGD is fetched at a pinned commit (see data/raw/README.md), never redistributed in full.
data/upstream/
# Working files of the annotation rounds (blind packets, launchers, filled sheets); the released data is data/gold/.
data/annotations/
data/intermediate/
data/prospective_holdout/private_pool/

# Released gold: only the final versions; superseded builds stay local and are rebuilt by scripts/build_gold_*.py.
data/gold/*
!data/gold/README.md
!data/gold/train_dev_gold_v1_3.jsonl
!data/gold/test_reference_v1.jsonl
!data/gold/full_gold_v1_3_plus_test.jsonl

# Model runs and checkpoints are large; their hashes and metrics are in reports/.
reports/train_runs/
reports/sgd_train_audit/
reports/sgd_smoke/
reports/splits/*
!reports/splits/frozen_full_manifest_v1_3.json
!reports/splits/frozen_plan_traindev_gold_v1_3.json
checkpoints/
models/

# Local AI pre-review drafts from the pilot (never shown to annotators, not part of the release)
OVERRIDE_PILOT30_AI_PRE_REVIEW/

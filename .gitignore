__pycache__/
*.py[cod]
.venv/
.env
.env.*
!.env.example
.pytest_cache/
.ipynb_checkpoints/
# Raw upstream source is pinned/downloaded separately; curate legally compliant exports later.
data/upstream/
# Do not commit unreviewed annotation packets, annotator identity notes, or private sampler hints.
data/annotations/
# Locally generated unreviewed/intermediate artifacts until reviewed for publication.
data/intermediate/
# Blind prospective-test pool text stays private (hashes/IDs only in the lock manifest).
data/prospective_holdout/private_pool/
reports/sgd_train_audit/
reports/sgd_smoke/
*.tmp
# Gold human annotations should remain local until release/legal & leakage review.
data/gold/*
# ...but the honesty README that declares 'GOLD NOT AVAILABLE' must stay visible.
!data/gold/README.md
# Reports contain unreviewed/possibly identifiable examples; export only reviewed reports.
reports/splits/
reports/train_runs/
# Large model artifacts are not necessary for assignment repo unless explicitly requested.
checkpoints/
models/
